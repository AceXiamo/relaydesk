# Copy to runner.env (0600), outside the repository in production.
# Set to the HTTPS origin reachable from inside this runner's network.
RELAYDESK_URL=https://relaydesk.example.com
RELAYDESK_PROJECT=
RELAYDESK_AGENT_KEY=
RELAYDESK_REPO=owner/repository
RELAYDESK_CLI=codex
# Supply a dedicated, scoped credential for ONLY the configured provider.
CODEX_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: a repo-scoped token with read access to contents and pull requests.
# RELAYDESK_GITHUB_TOKEN=
